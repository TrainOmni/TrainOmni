{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainomni.local/schema/sample-v0.1.schema.json",
  "title": "TrainOmni Canonical Sample v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "objective", "messages"],
  "properties": {
    "schema_version": {
      "const": "trainomni.sample.v0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "enum": ["cpt", "sft", "preference", "prompt_only"]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "default": []
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "preference": {
      "$ref": "#/$defs/preference"
    },
    "rollout": {
      "$ref": "#/$defs/rollout"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "objective": {
            "const": "preference"
          }
        },
        "required": ["objective"]
      },
      "then": {
        "required": ["preference"]
      }
    },
    {
      "if": {
        "properties": {
          "objective": {
            "const": "prompt_only"
          }
        },
        "required": ["objective"]
      },
      "then": {
        "required": ["rollout"]
      }
    }
  ],
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {
          "enum": ["system", "user", "assistant", "tool", "document"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content_block"
          }
        },
        "loss_weight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "content_block": {
      "oneOf": [
        {
          "$ref": "#/$defs/text_block"
        },
        {
          "$ref": "#/$defs/media_block"
        },
        {
          "$ref": "#/$defs/bbox_block"
        },
        {
          "$ref": "#/$defs/point_block"
        },
        {
          "$ref": "#/$defs/json_block"
        },
        {
          "$ref": "#/$defs/tool_call_block"
        },
        {
          "$ref": "#/$defs/tool_result_block"
        }
      ]
    },
    "text_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string"
        },
        "loss_weight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "media_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "asset_id"],
      "properties": {
        "type": {
          "const": "media"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "loss_weight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "bbox_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "asset_id", "xyxy", "coordinate_space"],
      "properties": {
        "type": {
          "const": "bbox"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "xyxy": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "coordinate_space": {
          "enum": ["pixel", "norm_0_1"]
        },
        "label": {
          "type": "string"
        },
        "loss_weight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "point_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "asset_id", "xy", "coordinate_space"],
      "properties": {
        "type": {
          "const": "point"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "xy": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "coordinate_space": {
          "enum": ["pixel", "norm_0_1"]
        },
        "label": {
          "type": "string"
        },
        "loss_weight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "json_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "json"
        },
        "value": {},
        "loss_weight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tool_call_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "arguments"],
      "properties": {
        "type": {
          "const": "tool_call"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        },
        "call_id": {
          "type": "string"
        },
        "loss_weight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tool_result_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "tool_result"
        },
        "name": {
          "type": "string"
        },
        "call_id": {
          "type": "string"
        },
        "value": {},
        "loss_weight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "modality", "uri"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "modality": {
          "enum": ["image", "video", "audio"]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "mime_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "num_frames": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages"],
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "score": {
          "type": "number"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chosen", "rejected"],
      "properties": {
        "chosen": {
          "$ref": "#/$defs/candidate"
        },
        "rejected": {
          "$ref": "#/$defs/candidate"
        },
        "margin": {
          "type": "number"
        },
        "judge": {
          "type": "string"
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "default": 1
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifiers"],
      "properties": {
        "verifiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/verifier"
          }
        },
        "environment": {
          "type": "string"
        },
        "max_completion_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "reference_answer": {}
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "split": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "quality": {
          "type": "number"
        },
        "difficulty": {
          "type": "number"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
